# BetOracle Contracts - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Required for Deployment
# ============================================================================

# Your wallet private key (with CELO for gas fees)
# ⚠️ NEVER commit this to git - add .env to .gitignore
PRIVATE_KEY=0x...

# RPC URLs (defaults to Celo Mainnet)
# For testnet: https://alfajores-forno.celo-testnet.org
RPC_URL=https://forno.celo.org

# ============================================================================
# CeloScan (for contract verification)
# ============================================================================

# Get API key from https://celoscan.io/myapikey
CELOSCAN_API_KEY=...

# ============================================================================
# Backend Integration (set after deployment)
# ============================================================================

# These values are generated AFTER you run Deploy.s.sol
# Copy them from deployment output into backend/.env

# AGENT_ID=0x... (32 bytes hex)
# AGENT_WALLET=0x...
# PREDICTION_CONTRACT=0x...

# Backend wallet address (to authorize for submitting predictions)
BACKEND_ADDRESS=0x...
